<form class="qb-form"><p>{{localize "QUEST-BOARD.ChooseBoardForTemplate" template=templateName}}</p><div class="form-group"><label>{{localize "QUEST-BOARD.SelectBoard"}}</label><select name="boardId">{{#each boards as |board|}}<option value="{{board.id}}">{{board.name}}</option>{{/each}}</select></div><footer class="form-footer"><button type="button" data-action="choose">{{localize "QUEST-BOARD.CreateFromTemplate"}}</button></footer></form>